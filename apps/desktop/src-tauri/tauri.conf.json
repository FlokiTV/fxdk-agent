{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FXDK Agent",
  "version": "0.1.0",
  "identifier": "dev.flokitv.fxdk-agent",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FXDK Agent",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
