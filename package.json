{
  "name": "fxdk-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck:protocol": "bunx tsc --noEmit -p packages/protocol/tsconfig.json",
    "typecheck:desktop": "bun run --cwd apps/desktop typecheck",
    "typecheck": "bun run typecheck:protocol && bun run typecheck:desktop",
    "check:rust": "cargo check --workspace",
    "check": "bun run typecheck && bun run check:rust",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:windows": "bun run --cwd apps/desktop tauri build --no-bundle",
    "verify:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-standalone.ps1",
    "release:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone.ps1",
    "build:rust": "cargo build --workspace",
    "build": "bun run build:desktop && bun run build:rust",
    "dev:desktop": "bun run --cwd apps/desktop tauri dev"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
